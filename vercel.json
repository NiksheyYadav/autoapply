{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "functions": {
    "api/auth/index.ts": { "maxDuration": 30 },
    "api/profile/index.ts": { "maxDuration": 30 },
    "api/jobs/index.ts": { "maxDuration": 30 },
    "api/matching/index.ts": { "maxDuration": 30 },
    "api/applications/index.ts": { "maxDuration": 30 },
    "api/referrals/index.ts": { "maxDuration": 30 },
    "api/outreach/index.ts": { "maxDuration": 30 },
    "api/learning/index.ts": { "maxDuration": 30 },
    "api/analytics/index.ts": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/v1/auth/:path*", "destination": "/api/auth" },
    { "source": "/v1/profile/:path*", "destination": "/api/profile" },
    { "source": "/v1/jobs/:path*", "destination": "/api/jobs" },
    { "source": "/v1/matching/:path*", "destination": "/api/matching" },
    { "source": "/v1/applications/:path*", "destination": "/api/applications" },
    { "source": "/v1/referrals/:path*", "destination": "/api/referrals" },
    { "source": "/v1/outreach/:path*", "destination": "/api/outreach" },
    { "source": "/v1/learning/:path*", "destination": "/api/learning" },
    { "source": "/v1/analytics/:path*", "destination": "/api/analytics" }
  ]
}
