# Project Atlas — local development defaults.
# Copy to .env and adjust. Never commit .env (docs/09, docs/10).
# Production values come from AWS Secrets Manager, not from files.

NODE_ENV=development
LOG_LEVEL=debug

# --- Datastores -------------------------------------------------------------
DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas
REDIS_URL=redis://localhost:6379

# Used by integration tests. When unset, DB-backed tests self-skip.
ATLAS_TEST_DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas_test

# --- Messaging --------------------------------------------------------------
# driver: memory | rabbitmq
MESSAGING_DRIVER=memory
RABBITMQ_URL=amqp://atlas:atlas@localhost:5672

# --- Storage ----------------------------------------------------------------
# driver: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./.atlas-storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=

# --- Auth -------------------------------------------------------------------
# Dev-only placeholder. Generate per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-insecure-secret-change-me-0000000000000000
JWT_ISSUER=atlas
JWT_AUDIENCE=atlas-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- OAuth sign-in providers (auth-service) ---------------------------------
# Leave a provider's id/secret blank to disable it — its routes 503 with
# OAUTH_PROVIDER_UNAVAILABLE rather than the service failing to boot.
# Never commit real values here; get them from each provider's console:
#   Google:    https://console.cloud.google.com/apis/credentials
#   Microsoft: https://portal.azure.com (Entra ID > App registrations)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# auth-service's own externally-reachable origin (builds the OAuth redirect_uri).
OAUTH_REDIRECT_BASE_URL=http://localhost:4001
# Where the browser lands once an OAuth sign-in completes.
WEB_APP_URL=http://localhost:3000

# --- Service ports ----------------------------------------------------------
AUTH_SERVICE_PORT=4001
PROFILE_SERVICE_PORT=4002
JOBS_SERVICE_PORT=4003
MATCHING_SERVICE_PORT=4004
APPLICATIONS_SERVICE_PORT=4005
REFERRALS_SERVICE_PORT=4006
OUTREACH_SERVICE_PORT=4007
LEARNING_SERVICE_PORT=4008
ANALYTICS_SERVICE_PORT=4009
CONNECTORS_SERVICE_PORT=4010

# connectors-service secret store: local (dev-only, plaintext on disk) | kms (not implemented yet)
SECRET_STORE_DRIVER=local
SECRET_STORE_LOCAL_ROOT=./.atlas-secrets

# outreach-service transport: local (logs only, safe default) | smtp (not implemented yet)
OUTREACH_TRANSPORT_DRIVER=local
