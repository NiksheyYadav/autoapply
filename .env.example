# Project Atlas — local development defaults.
# Copy to .env and adjust. Never commit .env (docs/09, docs/10).
# Production values come from AWS Secrets Manager, not from files.

NODE_ENV=development
LOG_LEVEL=debug

# --- Datastores -------------------------------------------------------------
DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas
REDIS_URL=redis://localhost:6379

# Used by integration tests. When unset, DB-backed tests self-skip.
ATLAS_TEST_DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas_test

# --- Messaging --------------------------------------------------------------
# driver: memory | rabbitmq | postgres
#   memory   - in-process, for tests and a single local process (default)
#   postgres - durable outbox in the shared database; the only driver that
#              delivers events across Vercel functions. Consumers (matching,
#              referrals, learning, analytics) only run when their
#              /internal/drain route is hit, so CRON_SECRET must be set there.
MESSAGING_DRIVER=memory
RABBITMQ_URL=amqp://atlas:atlas@localhost:5672
# Bearer secret for POST|GET /internal/drain on the four consumer services
# (Vercel Cron sends it as `Authorization: Bearer $CRON_SECRET`). At least 16
# characters, e.g. `openssl rand -hex 32`. Unset, the route answers 503.
# CRON_SECRET=

# --- Storage ----------------------------------------------------------------
# driver: local | supabase  (s3 is reserved, not implemented)
# local = files on disk (development only; ephemeral on Vercel).
# supabase = a PRIVATE Supabase Storage bucket (production): create the bucket in the
# dashboard, then set the two values below on the services that touch resume files: the
# profile service (uploads) and the auth service (deletes a user's files when they delete
# their account). On Vercel, where every service shares one project's environment, that is
# automatic.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./.atlas-storage
SUPABASE_STORAGE_BUCKET=resumes
# Server-side secret key (sb_secret_... or legacy service_role). Bypasses RLS: never commit it.
SUPABASE_SECRET_KEY=
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=

# --- Auth (Supabase) ---------------------------------------------------------
# Auth is Supabase Auth now, not a self-issued JWT — see
# packages/db/supabase/auth-hooks.sql and packages/auth-kit. Every service
# that verifies a caller's identity needs only the (non-secret) project URL;
# tokens are checked against its JWKS, not a shared secret.
SUPABASE_URL=https://your-project-ref.supabase.co
# Management-API token, dev-only convenience for scripts that configure the
# project (e.g. registering the auth hook, enabling OAuth providers) — not
# read by any service at runtime. Get one from
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Google/Microsoft/GitHub OAuth apps are configured once in the Supabase
# Dashboard (Authentication > Providers), not per-service env vars:
#   Google:    https://console.cloud.google.com/apis/credentials
#   Microsoft: https://portal.azure.com (Entra ID > App registrations) — Supabase's provider id is "azure"
#   GitHub:    https://github.com/settings/developers
# Each app's authorized redirect URI is https://<project-ref>.supabase.co/auth/v1/callback.

# Platform administrators: comma-separated auth.users ids allowed to touch GLOBAL
# data (jobs-service POST /v1/jobs/ingest, referrals-service POST /v1/contacts,
# learning-service GET /v1/learning/metrics).
# Deliberately separate from org admin/owner roles, which only carry authority
# inside one organization. Empty or unset = nobody (fail closed). Read by
# jobs-service, referrals-service and learning-service only.
PLATFORM_ADMIN_USER_IDS=

# --- Account privacy (auth service) -------------------------------------------
# Per-client-address budgets for GET /v1/auth/me/export and DELETE /v1/auth/me. They replace
# (do not add to) the general RATE_LIMIT_* budget on those two routes. Counters live in each
# function instance's memory. Raise them if many people share one address (a campus network).
# PRIVACY_EXPORT_RATE_LIMIT_MAX=10
# PRIVACY_DELETE_RATE_LIMIT_MAX=3
# PRIVACY_RATE_LIMIT_WINDOW=1 hour

# --- Service ports ----------------------------------------------------------
AUTH_SERVICE_PORT=4001
PROFILE_SERVICE_PORT=4002
JOBS_SERVICE_PORT=4003
MATCHING_SERVICE_PORT=4004
APPLICATIONS_SERVICE_PORT=4005
REFERRALS_SERVICE_PORT=4006
OUTREACH_SERVICE_PORT=4007
LEARNING_SERVICE_PORT=4008
ANALYTICS_SERVICE_PORT=4009
CONNECTORS_SERVICE_PORT=4010
ADMIN_SERVICE_PORT=4011

# connectors-service secret store: local (dev-only, plaintext on disk) | kms (not implemented yet)
SECRET_STORE_DRIVER=local
SECRET_STORE_LOCAL_ROOT=./.atlas-secrets

# outreach-service transport: local (logs only, dev/test) | smtp (not implemented yet)
OUTREACH_TRANSPORT_DRIVER=local

# outreach-service: let Atlas itself "send" (POST /v1/messages/:id/send) and schedule messages.
# Keep false. No transport delivers anything yet (local only logs, smtp is not implemented), so
# true would mark messages "sent" and tell users they went out when nothing was delivered. When
# false, send and schedule are rejected with 503 before anything is written; users copy or open
# the draft in their own mail app and record it with POST /v1/messages/:id/mark-sent.
# Must be exactly a boolean word (true/false/1/0/yes/no/on/off): a typo fails at boot. Even when
# true, nothing dispatches scheduled messages (no worker), and NODE_ENV=production refuses true
# together with OUTREACH_TRANSPORT_DRIVER=local. Set true only for local dev or tests.
OUTREACH_DELIVERY_ENABLED=false

# applications-service: accept mode "auto" on POST /v1/applications. Keep false until a submission
# worker consumes queued applications — otherwise auto applications sit in "queued" forever.
# When false, mode "auto" is rejected with 400 VALIDATION_ERROR; "manual" and "review" are unaffected.
APPLICATIONS_AUTO_MODE_ENABLED=false
