{
  "name": "project-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @atlas/db run generate",
    "db:migrate": "pnpm --filter @atlas/db run migrate",
    "build": "turbo run build",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "infra:logs": "docker compose logs -f",
    "dev:auth": "pnpm --filter @atlas/auth-service run dev",
    "dev:profile": "pnpm --filter @atlas/profile-service run dev",
    "dev:jobs": "pnpm --filter @atlas/jobs-service run dev",
    "dev:matching": "pnpm --filter @atlas/matching-service run dev",
    "dev:applications": "pnpm --filter @atlas/applications-service run dev",
    "dev:referrals": "pnpm --filter @atlas/referrals-service run dev",
    "dev:outreach": "pnpm --filter @atlas/outreach-service run dev",
    "dev:web": "pnpm --filter @atlas/web run dev",
    "dev:learning": "pnpm --filter @atlas/learning-service run dev",
    "dev:analytics": "pnpm --filter @atlas/analytics-service run dev",
    "dev:connectors": "pnpm --filter @atlas/connectors-service run dev",
    "dev:workers": "pnpm --filter @atlas/jobs-service run dev:worker"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.20.0",
    "prettier": "^3.4.2",
    "tsx": "^4.23.1",
    "turbo": "^2.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^4.1.10"
  }
}
